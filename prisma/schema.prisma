generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  stock       Int
  category    String   @default("geral")
  colors      String
  sizes       String
  imageUrl    String
  imageUrls   String   @default("")
  description String   @default("") @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  variants   ProductVariant[]
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  size      String
  stock     Int     @default(0)

  @@unique([productId, color, size])
}

model Order {
  id              String      @id @default(uuid())
  address         String
  paymentMethod   String
  total           Float
  status          String      @default("Pendente")
  customerName    String      @default("")
  customerEmail   String      @default("")
  region          String      @default("tupi")
  cep             String      @default("")
  bairro          String      @default("")
  cidade          String      @default("")
  shippingFee     Float       @default(0)
  subtotal        Float       @default(0)
  couponCode      String      @default("")
  couponDiscount  Float       @default(0)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  title       String
  category    String    @default("todos") // "exclusivo" | "todos" | "boasvindas"
  discountType String   @default("percentual") // "percentual" | "fixo"
  value       Float
  maxUses     Int?
  usesCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Float
  quantity  Int     @default(1)
  size      String
  color     String
}

