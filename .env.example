# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" de verdade pro GitHub (ele já está no .gitignore).

# --- Banco de dados (o mesmo MySQL que você já tem na Hostinger) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u643153119_seu_usuario
DB_PASSWORD=sua_senha_do_banco
DB_NAME=u643153119_fvfitwear

# --- Servidor ---
PORT=3000
# Domínio(s) que podem chamar a API (separados por vírgula, sem espaço)
CORS_ORIGINS=https://fvfitwear.com.br,https://www.fvfitwear.com.br

# URL pública onde a API fica acessível (usada para montar o link das fotos enviadas)
BASE_URL=https://fvfitwear.fvfitwear.com.br

# --- Autenticação do admin ---
# Gere um segredo forte, ex: rode no terminal -> node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_isso_por_um_segredo_bem_grande_e_aleatorio
ADMIN_USERNAME=fitwear

# Gere o hash da sua senha de admin rodando:
# node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA_AQUI', 10))"
# e cole o resultado abaixo (NÃO coloque a senha em texto puro aqui)
ADMIN_PASSWORD_HASH=cole_aqui_o_hash_gerado_pelo_bcrypt
